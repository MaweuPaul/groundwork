PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=groundwork
DB_SSLMODE=disable

# Optional: Complete DSN connection string override
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/groundwork?sslmode=disable

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
