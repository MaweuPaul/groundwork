# Copy to .env and fill in. .env is git-ignored; this file is not, so keep secrets out of it.

# --- Google Earth Engine ---------------------------------------------------
# Earth Engine has no API key. The worker signs in as a Google Cloud service account:
#   1. In Google Cloud, pick a project, enable the "Google Earth Engine API", and
#      register the project for Earth Engine (code.earthengine.google.com/register).
#   2. IAM > Service accounts: create one and grant it "Earth Engine Resource Viewer"
#      and "Service Usage Consumer".
#   3. Keys > Add key > JSON. Save the file in credentials/ (git-ignored) and point
#      GOOGLE_APPLICATION_CREDENTIALS at it.
GEE_PROJECT=your-cloud-project-id
GOOGLE_APPLICATION_CREDENTIALS=credentials/earth-engine-key.json

# --- Database --------------------------------------------------------------
# The worker connects as the least-privilege gee_worker role from migration 006.
# It is created without a password; set one with:  ALTER ROLE gee_worker PASSWORD '...';
DATABASE_URL=postgresql://gee_worker:CHANGE_ME@localhost:5432/groundwork

# Shown in snapshot_jobs.locked_by, so you can tell workers apart.
WORKER_ID=gee-worker-1
